# OpenSearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-secret

# ClickHouse analytics
FTN_CLICKHOUSE_USER=ftn
FTN_CLICKHOUSE_PASSWORD=replace-with-a-strong-analytics-secret
FTN_CLICKHOUSE_DATABASE=ftn_analytics
# Control-plane reaches ClickHouse over the shared FTN control-plane network.
FTN_CLICKHOUSE_URL=http://clickhouse:8123

# Kopia
KOPIA_PASSWORD=replace-with-a-strong-repository-secret
KOPIA_SERVER_USERNAME=ftn-admin
KOPIA_SERVER_PASSWORD=replace-with-a-strong-server-secret
# Pin this before production instead of relying on latest.
KOPIA_VERSION=latest
