# Local runtime configuration. Never commit production secrets.
FTN_DB_PASSWORD=change-this-before-production
# When set, all /api/v1/* routes require Authorization: Bearer <token>.
# Keep this secret outside Git and rotate it periodically.
FTN_API_AUTH_TOKEN=
FTN_CONTROL_ADDR=:8080
FTN_HEALTH_URL=http://127.0.0.1:8080/healthz
# Live NetFlow v5/v9 and IPFIX UDP ingress. Disabled unless both values are set.
# FTN_FLOW_LISTEN_ADDR=:2055
# Comma-separated exporter source IPs. Unknown exporters are rejected before decoding.
# FTN_FLOW_EXPORTERS=10.0.0.1,10.0.0.2
# DATABASE_URL is normally assembled by docker-compose from FTN_DB_PASSWORD.
