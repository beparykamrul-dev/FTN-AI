# FTN-AI V1 runtime environment template
# Never commit real secrets here.

APP_ENV=production
APP_NAME=ftn-ai
HTTP_ADDR=0.0.0.0:8080

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ftn_ai
PGUSER=ftn_ai
PGPASSWORD=CHANGE_ME
PGSSLMODE=verify-full
DATABASE_URL=postgres://ftn_ai:CHANGE_ME@127.0.0.1:5432/ftn_ai?sslmode=verify-full

# Account / IAM
SESSION_TTL=24h
SESSION_IDLE_TTL=2h

# AI governance
AI_APPROVAL_TTL=15m
AI_EXECUTION_TIMEOUT=30s
AI_MAX_RETRIES=3
AI_EVENT_REPLAY_LIMIT=500

# Mail / BlobStore
MAIL_BLOB_ROOT=/var/lib/ftn-ai/mail/blobs
MAIL_BLOB_CHUNK_SIZE=1048576
MAIL_STREAM_BUFFER_SIZE=65536
MAIL_MAX_ATTACHMENT_SIZE=10737418240

# DNS monitoring
DNS_HEALTH_INTERVAL=30s
DNS_PROBE_TIMEOUT=5s
DNS_METRICS_RETENTION_DAYS=30
DNS_HISTORY_RETENTION_DAYS=365

# Event delivery
EVENT_REPLAY_ENABLED=true
SSE_ENABLED=true
WEBSOCKET_ENABLED=true

# Secrets must be injected by deployment secret management.
# AI_ENCRYPTION_KEY=DO_NOT_COMMIT
# MAIL_MASTER_KEY=DO_NOT_COMMIT
