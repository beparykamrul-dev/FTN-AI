# FTN-AI Configuration

# Environment
ENVIRONMENT=production
DEBUG=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ftn_ai
DATABASE_POOL_SIZE=20
DATABASE_SSL_MODE=require

# AI Governance
AI_GOVERNANCE_ENABLED=true
AI_APPROVAL_REQUIRED=true
AI_MAX_TOKENS=4000
AI_TIMEOUT=30s

# Mail Configuration
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_FROM=noreply@ftn-ai.com
MAIL_ENCRYPTION=tls

# DNS Configuration
DNS_PROVIDER=cloudflare
DNS_API_KEY=your-api-key

# Security
SECURE_COOKIES=true
CORS_ALLOWED_ORIGINS=https://ftn-ai.com
CSRF_PROTECTION=true

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=info